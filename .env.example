# Required: PostgreSQL connection used by the app and drizzle-kit.
DATABASE_URL=postgres://user:password@host:5432/study_planner?sslmode=require

# ── SHIGUN AI Cloud Providers ─────────────────────────────────────
# NO KEY YET? The app still gets cloud tutoring. Three routes, in order:
#   1. the variables below — a key every learner shares (server-side);
#   2. Settings → AI coach — a key pasted in ONE browser, kept in its
#      localStorage and used immediately, no redeploy. Since v34 that key is
#      also called DIRECTLY FROM THE BROWSER when the server cannot reach the
#      provider itself (see "Browser-direct AI bridge" below);
#   3. no key at all — the browser falls back to free anonymous community
#      relays (OVHcloud AI Endpoints → Kilo Gateway → Pollinations), which the
#      learner can switch off in Settings and you can forbid with
#      AI_FREE_BRIDGE=off below.
#
# BROWSER-DIRECT AI BRIDGE (v34): a host with no outbound network — a
# sandboxed preview, CI, a locked-down container — cannot reach ANY provider,
# so a valid key still produced "AI is not connected". The learner's browser
# is on the open internet, so lib/aiBridge.ts makes the model call there and
# hands the answer back to /api/chat, which still owns grounding, actions,
# replanning and persistence. Nothing to configure; deployments WITH a key
# keep using the server chain first.
#
# SHIGUN uses a 7-provider priority chain:
#   Cerebras → Groq → Mistral → SambaNova → Cohere → Gemini → OpenRouter
# Configure ANY number (at least one is recommended). NEVER use NEXT_PUBLIC_ for secret keys.
# The local ML engine (FSRS, pace models, skip-risk) always runs regardless of AI keys.
# Each provider also walks its own model-fallback chain, so a retired model id
# (or one provider being down) costs one fast request, not the whole answer.
# Failures are REMEMBERED (rejected key 10 min, retired model 30 min, rate
# limit ~45 s, stall ~60 s) so the next request skips the broken leg, and a
# second provider is started in parallel after 2.5 s of silence from the
# first. GET /api/ai-status shows what is benched and why.
# Model lists were verified against each vendor's catalogue in Sept 2026.

# 1. Cerebras — ultra-fast inference (recommended primary, ~2000+ tok/s)
#    Get key: https://cloud.cerebras.ai → API Keys
#    Public chat models today: gpt-oss-120b, qwen-3.8-27b (the Llama ids
#    are retired — leave CEREBRAS_MODEL unset to use the built-in chain).
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# 2. Groq — LPU inference, first fallback after Cerebras, free developer tier
#    Get key: https://console.groq.com → API Keys
#    Free tier: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
#    (llama-3.3-70b-versatile / llama-3.1-8b-instant are Enterprise-only now).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 3. Mistral AI — high-quality European models
#    Get key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest  # chat-model IDs only (no embed / rerank)

# 4. SambaNova Cloud — fast open-weight inference
#    Get key: https://cloud.sambanova.ai → API Authorization
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# 5. Cohere — command-r-plus for retrieval-grounded tutoring
#    Get key: https://dashboard.cohere.com → API Keys
COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025    # only chat / instruction models (never rerank/embed IDs)

# 6. Gemini — Google's model, used as final cloud safety net
#    Get key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # accepted alias for Gemini
# GEMINI_MODEL=gemini-flash-latest

# 7. OpenRouter — one key, many vendors; the widest last cloud leg
#    Get key: https://openrouter.ai → Keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b

# ── Connectivity tuning (optional) ───────────────────────────────
# Total shared budget for one AI answer across all providers (ms).
# AI_TIMEOUT_MS=24000
# Override the provider priority order, e.g. "mistral,cerebras,gemini"
# AI_PROVIDER_ORDER=cerebras,groq,mistral,sambanova,cohere,gemini,openrouter

# Forbid the free community relays the browser bridge can fall back to when no
# key exists anywhere. Default: allowed. Set this if your learners' questions
# must never reach a public anonymous endpoint — with it off, a deployment with
# no key answers from the on-device engine only (and says so plainly).
# Reported by GET /api/ai-status, so the change applies without a rebuild.
# AI_FREE_BRIDGE=off

# Optional high-quality voice (TTS). Falls back to browser device voice.
# GOOGLE_CLOUD_TTS_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Public canonical URL (used for internal attribution metadata only).
# APP_URL=https://your-study-planner.example

# Preview-only: with this flag and NO database, the UI is served a
# deterministic sample plan so the interface can be reviewed in a
# sandbox/preview environment. Never set it in production.
# SPP_DEMO_DATA=1

# Privacy-safe defaults: course-query telemetry is OFF.
# ENABLE_COURSE_TELEMETRY=false
# COURSE_REPORT_TOKEN=

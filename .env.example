# Required: PostgreSQL connection used by the app and drizzle-kit.
# It is also where ACCOUNTS live - usernames, scrypt password hashes and the
# session rows that keep a learner signed in on every device. Without it
# nobody can sign up, so a real deployment must set it.
DATABASE_URL=postgres://user:password@host:5432/study_planner?sslmode=require

# ── Accounts / sessions ──────────────────────────────────────────
# Nothing here is required. Schema: `npm run db:push` applies the account
# columns and the auth_sessions table; if a deployment skips that step, the
# app applies them itself on the first sign-in request (idempotent DDL).
#
# SameSite policy for the session cookie. Leave UNSET for any normal
# deployment - the default `lax` is what protects a sign-in from cross-site
# request forgery. Set it to `none` ONLY when the app is embedded in an
# iframe on another origin (a preview/demo frame), because a Lax cookie is
# never sent in that context and sign-in would silently fail to stick.
# `none` always implies Secure, so it requires https.
# SPP_COOKIE_SAMESITE=lax

# ── SHIGUN AI Cloud Providers ─────────────────────────────────────
# Keys are configured ONLY here, in the deployment environment (e.g. Vercel
# → Project → Settings → Environment Variables). Every learner on the
# deployment then gets cloud tutoring automatically - nobody ever pastes a
# key anywhere in the app, and nothing in the UI asks for one.
#
# SHIGUN walks this production priority chain:
#   Gemini → Cerebras → Mistral → SambaNova → Cohere
# (Groq and OpenRouter are optional extra legs behind those five - a
# deployment without those keys skips them entirely, and the on-device ML
# engine always runs last.) Configure ANY number (at least one is
# recommended; two or more is better - the whole point of the chain is that
# a dead Gemini is answered by Cerebras):
#   • a question is sent to the first configured provider;
#   • if that provider is rate-limited, out of quota, disconnected or its
#     model is retired, the NEXT provider answers inside the same request;
#   • a throttled provider is NOT written off: once every healthy leg has
#     been tried, the chain waits (boundedly, see AI_RECOVERY_MS) for the
#     throttled leg's window to reopen and retries it before giving up;
#   • only when EVERY configured provider fails does the on-device ML engine
#     answer from the learner's own plan, syllabus and learned signals - a
#     question is never left unanswered.
# NEVER use NEXT_PUBLIC_ for secret keys.
#
# The local ML engine (FSRS, pace models, skip-risk) always runs regardless
# of AI keys, and it is what answers whenever NO cloud leg produced a usable
# reply. Each provider also walks its own model-fallback chain, so a retired
# model id (or one provider being down) costs one fast request, not the whole
# answer. Failures are REMEMBERED (rejected key 10 min, retired model 30 min,
# rate limit ~45 s, stall ~60 s) so the next request skips the broken leg,
# and a second provider is started in parallel after 2.5 s of silence from
# the first. GET /api/ai-status shows what is benched and why.
#
# HTTP 200 IS NOT PROOF OF AN ANSWER. Some endpoints reply 200 with a valid
# OpenAI-shaped body whose content is their OWN notice - "The API key used
# for this request has reached its budget…". src/lib/aiAnswer.ts is the
# single judge of a 200 body: a provider notice is treated as a FAILURE, the
# leg is benched and the chain keeps walking. It is deliberately
# conservative - a lesson about a department that "has reached its budget
# ceiling" is cost accounting, not a billing error, and is always delivered
# untouched. Model lists were verified against each vendor's catalogue in
# Sept 2026.
#
# SHIGUN CREDIT (Settings → AI coach): the app shows each learner a usage
# meter - one credit per cloud-answered question, rolling over daily. It is
# INFORMATIONAL ONLY: it never blocks, throttles or degrades tutoring.

# 1. Gemini - Google's model, the PRIMARY leg. It is the key most
#    deployments configure first, so it is tried before everything else.
#    Get key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # accepted alias for Gemini
# GEMINI_MODEL=gemini-flash-latest

# 2. Cerebras - ultra-fast inference (~2000+ tok/s), first fallback.
#    Get key: https://cloud.cerebras.ai → API Keys
#    Public chat models today: gpt-oss-120b, qwen-3.8-27b (the Llama ids
#    are retired - leave CEREBRAS_MODEL unset to use the built-in chain).
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# 3. Mistral AI - high-quality European models
#    Get key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest  # chat-model IDs only (no embed / rerank)

# 4. SambaNova Cloud - fast open-weight inference
#    Get key: https://cloud.sambanova.ai → API Authorization
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# 5. Cohere - Command A for retrieval-grounded tutoring
#    Get key: https://dashboard.cohere.com → API Keys
COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025    # only chat / instruction models (never rerank/embed IDs)

# 6. Groq - OPTIONAL extra leg (LPU inference, free developer tier)
#    Get key: https://console.groq.com → API Keys
#    Free tier: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
#    (llama-3.3-70b-versatile / llama-3.1-8b-instant are Enterprise-only now).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 7. OpenRouter - OPTIONAL extra leg; one key, many vendors, widest safety net
#    Get key: https://openrouter.ai → Keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b

# ── Connectivity tuning (optional) ───────────────────────────────
# Total shared budget for one AI answer across all providers (ms). Default
# is 30 s: enough to walk the whole chain AND give a throttled leg one
# bounded second chance. The client waits 60 s, so this stays safe.
# AI_TIMEOUT_MS=30000
# Cap on how long the chain will wait for a throttled (rate-limited /
# timed-out / unreachable) provider's window to reopen before retrying it.
# Only spent after every healthy leg has already failed for the request, and
# always bounded by AI_TIMEOUT_MS. Set to 0 to disable the second chance.
# AI_RECOVERY_MS=12000
# Override the provider priority order, e.g. "cerebras,gemini,mistral"
# AI_PROVIDER_ORDER=gemini,cerebras,mistral,sambanova,cohere,groq,openrouter

# Optional high-quality voice (TTS). Falls back to browser device voices.
# GOOGLE_CLOUD_TTS_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Public canonical URL (used for internal attribution metadata only).
# APP_URL=https://your-study-planner.example

# Preview-only: with this flag and NO database, the UI is served a
# deterministic sample plan so the interface can be reviewed in a
# sandbox/preview environment. Never set it in production.
# SPP_DEMO_DATA=1

# Privacy-safe defaults: course-query telemetry is OFF.
# ENABLE_COURSE_TELEMETRY=false
# COURSE_REPORT_TOKEN=

# ── Email + notifications ────────────────────────────────────────────────
# Everything below is OPTIONAL. With none of it set, the app runs exactly as
# before: the bell works, settings are stored, and digests are written to a
# local outbox file (.spp-mail-outbox) instead of a real inbox. SETUP.md has
# click-by-click pictures of where each value comes from.
#
# 1) Gmail SMTP app password - the default way plan emails are sent.
#    myaccount.google.com/security -> 2-Step Verification -> App passwords.
#    Up to 500 recipients/day free on a normal Gmail account.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# The SMTP server defaults to smtp.gmail.com:465. Only touch these for a
# localhost workaround; production never needs them.
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=465
#
# 2) Prefer Brevo instead (300 emails/day free)? Fill ONLY these - when
#    BREVO_API_KEY exists and Gmail does not, Brevo sends the mail. No other
#    provider exists or will be added.
# BREVO_API_KEY=xkeysib-your-key-here
# BREVO_SENDER_EMAIL=you@gmail.com
#
# 3) Rarely needed: force one transport, or see the dry-run explicitly.
#    Values: auto (default), gmail-smtp, brevo, file.
# MAIL_TRANSPORT=auto
#
# 4) Google sign-in ("Continue with Google" on the front door). Both values
#    must be set, or the button simply never appears and nothing changes.
#    Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
#    (Web application). SETUP.md step 4 lists the exact redirect URIs.
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
#
# 5) The public address of the deployment. Used to build OAuth redirect and
#    email links. On Vercel set it to your production domain.
# APP_URL=https://your-app.vercel.app
#
# 6) Cron: the hourly worker that decides whose digest is due right now.
#    Any long random string. Vercel cron (vercel.json, once a day as a
#    backstop) and the GitHub Actions workflow call /api/cron/digest with
#    "Authorization: Bearer <this value>".
# CRON_SECRET=generate-a-long-random-string
#
# 7) The secret that signs verification and one-click unsubscribe links.
#    Falls back to CRON_SECRET when unset; set it separately if you want to
#    rotate cron access without killing links already in inboxes.
# MAIL_LINK_SECRET=generate-a-long-random-string

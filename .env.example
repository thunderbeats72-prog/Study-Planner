# Required: PostgreSQL connection used by the app and drizzle-kit.
DATABASE_URL=postgres://user:password@host:5432/study_planner?sslmode=require

# ── Cloud tutor providers ────────────────────────────────────────
# Configure ANY number (at least one recommended). The app tries them in
# order Gemini → Groq → Grok → OpenRouter with per-provider model fallback
# chains, one bounded retry for transient errors, and a deterministic local
# tutor if everything fails. NEVER use NEXT_PUBLIC_ for secret keys.
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # accepted alias for Gemini
# GEMINI_MODEL=gemini-flash-latest

# Groq (groq.com). NOTE: llama-3.3-70b-versatile was retired 2026-08-16 —
# the default is now openai/gpt-oss-120b with automatic fallbacks.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Grok (xAI). Set XAI_API_KEY from console.x.ai.
# XAI_API_KEY=
# GROK_MODEL=grok-4-fast-non-reasoning

# OpenRouter (one key, many models).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Connectivity tuning (optional) ───────────────────────────────
# Total shared budget for one AI answer across all providers (ms).
# AI_TIMEOUT_MS=24000
# Override the provider order, e.g. "openrouter,gemini".
# AI_PROVIDER_ORDER=gemini,groq,grok,openrouter

# Optional high-quality voice. If absent/unavailable, Gemini TTS and then the
# browser's device voice are used automatically.
# GOOGLE_CLOUD_TTS_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Public canonical URL sent only as OpenRouter attribution metadata.
# APP_URL=https://your-study-planner.example

# Privacy-safe defaults: course-query telemetry is OFF. Enable only if needed,
# then protect the private report endpoint with a long random bearer token.
# ENABLE_COURSE_TELEMETRY=false
# COURSE_REPORT_TOKEN=
